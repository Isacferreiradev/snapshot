# ─── Asaas — Pagamentos PIX ──────────────────────────────────────────────────
# Chave da API: painel.asaas.com → Configurações → Integrações → Chave de API
ASAAS_API_KEY=
# Ambiente: 'sandbox' para testes, 'production' para produção real
ASAAS_ENV=sandbox
# Token do webhook: painel.asaas.com → Configurações → Notificações → Integrações
ASAAS_WEBHOOK_TOKEN=

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=http://localhost:3001
NODE_ENV=development

# ─── Concorrência do Puppeteer ────────────────────────────────────────────────
# Número máximo de capturas rodando ao mesmo tempo (padrão: 2)
# Recomendado: 2 para servidores com 1–2 GB RAM, 3 para 4+ GB
MAX_CONCURRENT_CAPTURES=2

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=


# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://e1b31e329b6b83fa6e77aa8ae98f70f4@o4511063161307136.ingest.us.sentry.io/4511063164125184

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Resend — Emails Transacionais ───────────────────────────────────────────
# Chave da API do Resend — resend.com/api-keys
RESEND_API_KEY=
# Remetentes (domínio deve estar verificado no Resend)
EMAIL_FROM_MAIN=contato@snapdeck.pro
EMAIL_FROM_SUPPORT=suporte@snapdeck.pro
EMAIL_FROM_NOREPLY=noreply@snapdeck.pro
# Email interno para alertas de pagamento
ADMIN_ALERT_EMAIL=

# ─── Agente de QA — Revisão do Projeto ──────────────────────────────────────
# Chave da API da Anthropic para o agente de revisão de qualidade
# Obtenha em: console.anthropic.com/account/keys
# Necessária apenas para rodar: node qa-reviewer.js
# Não é usada pelo servidor em produção
ANTHROPIC_API_KEY=
